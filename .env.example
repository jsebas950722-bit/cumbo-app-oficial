# Copia este archivo a .env y completa con los datos de tu proyecto Supabase
# (Dashboard de Supabase > Project Settings > API)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU-ANON-KEY-PUBLICA

# Opcional — monitoreo de errores en producción (https://sentry.io, plan
# gratuito). Si lo dejas vacío, la app funciona igual, simplemente no
# reporta errores a ningún lado.
VITE_SENTRY_DSN=
